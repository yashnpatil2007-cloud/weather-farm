# ---- Backend environment (copy to .env) ----
# MUST be changed in any real deployment. HS256 signing key.
SECRET_KEY=change-this-random-secret-key-please

# Database URL.
# PostgreSQL (production): postgresql://user:password@localhost:5432/weather_farm
# SQLite (local/demo):       sqlite:///./farming.db
DATABASE_URL=sqlite:///./farming.db

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather provider. "open-meteo" (free, no API key) or "none" (demo mock only)
WEATHER_PROVIDER=open-meteo

# Allow mock/demo weather when the live provider is unavailable
ALLOW_WEATHER_MOCK=true

# Seconds to cache live weather responses (avoid hammering the API)
WEATHER_CACHE_SECONDS=900

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173